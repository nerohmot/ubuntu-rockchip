#!/bin/bash
# Module: omg status

show_help() {
    echo "Usage: omg status [options]"
    echo ""
    echo "Options:"
    echo "  --live    Live refreshing view (refreshes every 2s)"
    echo ""
    echo "Note: Running without options prints the current status to the screen once."
}

# --- THE DATA PRINT ENGINE ---
print_to_screen() {
    echo "🚢 OPEN MARINE GATEWAY STATUS"
    echo "------------------------------------------------"
    echo "⏱️  Uptime:         $(uptime -p)"
    
    # Check Snap Optimization
    echo -n "📦 OS Profile:     "
    if ! command -v snap >/dev/null; then echo "DE-SNAP-IFIED (Optimized)"; else echo "STANDARD"; fi
    
    echo "🌐 Signal K:       $(systemctl is-active signalk-server)"
    echo "📶 WiFi AP:        $(systemctl is-active hostapd)"
    
    # Check Parallel Bus Hardware
    echo -n "🧬 Parallel Bus:   "
    [ -c /dev/omg_bus ] && echo "CONNECTED" || echo "DISCONNECTED ⚠️"
    
    # Resources
    TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{print $1/1000 "°C"}')
    echo "🌡️  Core Temp:      ${TEMP:-N/A}"
    echo "------------------------------------------------"
}

# --- LOGIC ROUTER ---
case "$1" in
    --live)
        echo "📡 Entering Live Monitoring (Ctrl+C to exit)..."
        sleep 1
        # 'watch' runs the script and prints the output every 2 seconds
        watch -n 2 -t "/usr/local/lib/omg/omg-status"
        ;;
    help)
        show_help
        ;;
    *)
        # DEFAULT: Print to screen once
        print_to_screen
        ;;
esac
