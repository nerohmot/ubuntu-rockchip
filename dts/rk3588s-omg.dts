// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree Source for the Open Marine Gateway (OMG) board.
 * Based on the Radxa NX5 module (Rockchip RK3588S).
 *
 * Copyright (c) 2026 nerohmot
 *
 * TODO items (require final schematic sign-off):
 *   - Measure KSZ9897 board trace lengths to tune gmac1 RGMII TX/RX delay values
 */

/dts-v1/;

#include "rk3588s-radxa-nx5-module.dtsi"
#include <dt-bindings/display/rockchip_vop.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Open Marine Gateway";
	compatible = "nerohmot,omg", "radxa,nx5-module", "rockchip,rk3588s";

	aliases {
		ethernet0 = &gmac1;   /* KSZ9897 uplink (only GMAC in RK3588S) */
		serial2   = &uart2;   /* debug console  */
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	/* ------------------------------------------------------------------ */
	/* Power supplies                                                       */
	/* ------------------------------------------------------------------ */

	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_nvme: vcc3v3-nvme {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_nvme";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_wifi: vcc3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_wifi";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_cellular: vcc-cellular {
		compatible = "regulator-fixed";
		regulator-name = "vcc_cellular";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* ------------------------------------------------------------------ */
	/* Power-fail interrupt (RP2040 → NX5, GPIO0_B4, Pin 121)             */
	/* Triggers systemd power-off target when DC input is lost.           */
	/* ------------------------------------------------------------------ */

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&power_fail_int_pin>;

		power-fail {
			label = "Power Fail";
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
			debounce-interval = <10>;
		};
	};

	/* ------------------------------------------------------------------ */
	/* Safe-to-cut output (NX5 → RP2040, GPIO0_B3, Pin 119)               */
	/* Driven HIGH by userspace (systemd shutdown unit) when it is safe   */
	/* for the RP2040 to kill the 5V_always rail.                         */
	/* ------------------------------------------------------------------ */

	safe-to-cut-hog {
		compatible = "regulator-fixed";
		regulator-name = "safe_to_cut";
		gpio = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
		/* Default LOW (not safe). Userspace drives HIGH at shutdown. */
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/* ------------------------------------------------------------------ */
	/* Display audio nodes                                                 */
	/* ------------------------------------------------------------------ */

	hdmi0_sound: hdmi0-sound {
		status = "okay";
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,card-name = "rockchip-hdmi0";
		rockchip,cpu = <&i2s5_8ch>;
		rockchip,codec = <&hdmi0>;
		rockchip,jack-det;
	};

	dp0_sound: dp0-sound {
		status = "okay";
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <512>;
		rockchip,card-name = "rockchip-hdmi1";
		rockchip,cpu = <&spdif_tx2>;
		rockchip,codec = <&dp0 1>;
		rockchip,jack-det;
	};

	/* ------------------------------------------------------------------ */
	/* Management I2C – bit-bang                                          */
	/* SCL: GPIO0_C3 (SODIMM Pin 140)   SDA: GPIO0_C2 (SODIMM Pin 142)  */
	/* GPIO0_C3/C2 are general-purpose GPIO; not a hardware I2C7 mux.   */
	/* Pull-ups: 2.2 kΩ to 3.3V on PCB.                                  */
	/* ------------------------------------------------------------------ */
	i2c_mgmt: i2c-mgmt {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio0 RK_PC2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 RK_PC3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;

		/* Microchip KSZ9897 – 7-port Gigabit Switch, DSA               */
		ksz9897: ethernet-switch@5f {
			compatible = "microchip,ksz9897";
			reg = <0x5f>;

			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					label = "lan1";
					phy-mode = "internal";
				};
				port@1 {
					reg = <1>;
					label = "lan2";
					phy-mode = "internal";
				};
				port@2 {
					reg = <2>;
					label = "lan3";
					phy-mode = "internal";
				};
				port@3 {
					reg = <3>;
					label = "lan4";
					phy-mode = "internal";
				};
				port@4 {
					reg = <4>;
					label = "lan5";
					phy-mode = "internal";
				};
				/*
				 * KSZ9897 P6 (port@5) – MAC-only, no integrated PHY, left
				 * unconnected on v1 hardware.  5 downlink ports (lan1-lan5)
				 * are sufficient for the initial OMG design.
				 * If a 6th RJ45 port is ever needed, wire P6 via RGMII to
				 * an external PHY (e.g. TI DP83867IRPAP) and add:
				 *
				 *   port@5 {
				 *       reg = <5>;
				 *       label = "lan6";
				 *       phy-handle = <&lan6_phy>;
				 *       phy-mode = "rgmii-id";
				 *   };
				 *
				 * plus a matching mdio { lan6_phy: ethernet-phy@N { … }; }
				 * subnode inside ksz9897.
				 */
				/* CPU port – RGMII uplink to NX5 gmac1 */
				port@6 {
					reg = <6>;
					ethernet = <&gmac1>;
					phy-mode = "rgmii-id";
					fixed-link {
						speed = <1000>;
						full-duplex;
						pause;
					};
				};
			};

			};

		/* Microchip USB2517 – 7-port Industrial USB Hub #1 (cfg_sel0=GND) */
		usb2517_1: usb-hub@2c {
			compatible = "microchip,usb2517";
			reg = <0x2c>;
			reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
		};

		/* Microchip USB2517 – 7-port Industrial USB Hub #2 (cfg_sel0=3V3) */
		usb2517_2: usb-hub@2d {
			compatible = "microchip,usb2517";
			reg = <0x2d>;
			reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
		};

		/*
		 * RP2040 PSU supervisor.
		 * No upstream kernel driver; expose as a simple I2C device.
		 * A userspace daemon (omg-psu-daemon) handles the SCPI protocol.
		 */
		rp2040_psu: psu@44 {
			compatible = "nerohmot,omg-psu";
			reg = <0x44>;
		};
	};
};

/* ====================================================================== */
/* NETWORKING: KSZ9897 7-port Gigabit Switch (DSA via I2C)                */
/*                                                                         */
/* Physical connection: NX5 gmac1 ←RGMII→ KSZ9897 port 6 (CPU port)     */
/* Management:          bit-bang I2C (GPIO0_C3/C2), address 0x5F          */
/*                                                                         */
/* Note: RK3588S has only one GMAC (gmac1). The NX5 module DTSI configures*/
/* gmac1 for an onboard RTL8211F PHY that is not populated on the OMG     */
/* carrier board. We override that setup here to connect gmac1 RGMII to  */
/* the KSZ9897 switch CPU port instead.                                   */
/* ====================================================================== */

&gmac1 {
	status = "okay";
	phy-mode = "rgmii-id";
	clock_in_out = "output";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
	             &gmac1_tx_bus2
	             &gmac1_rx_bus2
	             &gmac1_rgmii_clk
	             &gmac1_rgmii_bus>;
	/* Remove onboard PHY properties added by the module DTSI */
	/delete-property/ phy-handle;
	/delete-property/ snps,reset-gpio;
	/delete-property/ snps,reset-active-low;
	/delete-property/ snps,reset-delays-us;
	/*
	 * TX/RX delays: tune against actual PCB trace lengths.
	 * Starting values from KSZ9897 reference design; validate with
	 * iperf3 + oscilloscope before finalising.
	 */
	tx-delay = <0x3c>;
	rx-delay = <0x00>;	/* rgmii-id: SoC adds both TX and RX delay */
};

/* ====================================================================== */
/* CAN / NMEA 2000 – TI ISO1050DUBR galvanically isolated transceiver     */
/* CAN1_TX_M1 → GPIO1_A1 (SODIMM Pin 118)                                */
/* CAN1_RX_M1 → GPIO1_A0 (SODIMM Pin 120)                                */
/* Bus side (VCC2) powered by N2K network 5V; LEN = 1.                   */
/* ====================================================================== */

&can1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&can1m1_pins>;
	assigned-clocks = <&cru CLK_CAN1>;
	assigned-clock-rates = <150000000>;
};

/* ====================================================================== */
/* UART2 – Debug console & RP2040 log monitor                             */
/* TX: GPIO0_B6 / UART2_TX_M0 (SODIMM Pin 123)                           */
/* RX: GPIO0_B5 / UART2_RX_M0 (SODIMM Pin 125)                           */
/* ====================================================================== */

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
};

/* ====================================================================== */
/* PCIe – M.2 M-Key Slot (NVMe SSD, PCIe 2.1 x1)                        */
/* PERST#: GPIO3_B7 → M.2 pin 22 (direct, no inverter needed).           */
/* GPIO_ACTIVE_HIGH: kernel value 0 → GPIO LOW → PERST# asserted;        */
/*                   kernel value 1 → GPIO HIGH → PERST# released.       */
/* ====================================================================== */

&combphy0_ps {
	status = "okay";
};

&pcie2x1l0 {
	status = "okay";
	vpcie3v3-supply = <&vcc3v3_nvme>;
	reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
};

/* ====================================================================== */
/* PCIe – M.2 E-Key Slot (WiFi/BT, PCIe 2.1 x1 + USB2 for Bluetooth)    */
/* combphy2_psu provides PCIe SS for WiFi (Intel AX210).                  */
/* u2phy1 / usbdrd3_1 provide USB2 for the AX210 Bluetooth interface.    */
/* usbdp_phy0 is fully allocated to DisplayPort so OTG1 is USB2-only.    */
/* PERST#: GPIO3_C0 → M.2 pin 22 (direct, no inverter — same convention  */
/* as NX5 IO board which uses GPIO3_D1 for its PCIe WiFi reset).         */
/* ====================================================================== */

&combphy2_psu {
	status = "okay";
};

&pcie2x1l2 {
	status = "okay";
	vpcie3v3-supply = <&vcc3v3_wifi>;
	reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
};

/* ====================================================================== */
/* USB – M.2 B-Key Slot (4G/5G Cellular modem, USB 2.0 High-Speed)       */
/*                                                                         */
/* combphy0_ps is consumed by NVMe PCIe; usbdp_phy0 is consumed by DP.   */
/* Therefore OTG0 has no SuperSpeed PHY and operates at USB 2.0 only     */
/* (480 Mbps), which is sufficient for 4G LTE (~150 Mbps peak).          */
/* ====================================================================== */

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "high-speed"; /* no SS PHY available; combphy0_ps→PCIe, usbdp_phy0→DP */
};

/* ====================================================================== */
/* USB – M.2 E-Key WiFi Bluetooth (USB 2.0 High-Speed via OTG1)           */
/*                                                                         */
/* usbdp_phy0 is fully in DisplayPort mode so OTG1 has no SS PHY.        */
/* u2phy1 provides standalone USB2 for the AX210 Bluetooth function.     */
/* ====================================================================== */

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "high-speed"; /* no SS PHY available; usbdp_phy0→DP */
};

/* ====================================================================== */
/* USB2 Host – feeds into USB2517 hub arrays                              */
/* u2phy2 → Hub #1 upstream → Legacy M.2 (port 1) + 6× external         */
/* u2phy3 → Hub #2 upstream → VectorE M.2 (port 1) + 6× external        */
/* ====================================================================== */

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

/* ====================================================================== */
/* Display – Primary: HDMI 2.1 (Chart Table, up to 8K@60Hz)              */
/* ====================================================================== */

&hdmi0 {
	status = "okay";
	cec-enable = "true";
};

&hdmi0_in_vp0 {
	status = "okay";
};

&route_hdmi0 {
	status = "okay";
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&i2s5_8ch {
	status = "okay";
};

/* ====================================================================== */
/* Display – Secondary: DisplayPort 1.4 direct output (Cockpit)           */
/*                                                                         */
/* No onboard DP-to-HDMI bridge. Direct DP is used to support non-        */
/* standard cockpit panels (e.g. 1920×480 bar displays) whose custom      */
/* timings are incompatible with active bridge PLL tables. The display's  */
/* full EDID is honoured by the RK3588S VOP2 scaler directly.             */
/* If the cockpit screen is HDMI-only, use an external active DP→HDMI     */
/* adapter/cable (preserves full timing flexibility, no onboard driver).  */
/* ====================================================================== */

&usbdp_phy0 {
	status = "okay";
	rockchip,dp-lane-mux = <0 1 2 3>;
};

&usbdp_phy0_dp {
	status = "okay";
};

&dp0 {
	status = "okay";
};

&dp0_in_vp2 {
	status = "okay";
};

&route_dp0 {
	status = "okay";
	connect = <&vp2_out_dp0>;
};

&spdif_tx2 {
	status = "okay";
};

/* ====================================================================== */
/* VOP2 video output pipeline                                             */
/* vp0 → HDMI0 (primary display)                                         */
/* vp2 → DP0  (secondary display via bridge)                             */
/* ====================================================================== */

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0 |
	                        1 << ROCKCHIP_VOP2_ESMART0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_CLUSTER0>;
	cursor-win-id = <ROCKCHIP_VOP2_ESMART0>;
};

&vp2 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER2 |
	                        1 << ROCKCHIP_VOP2_ESMART2)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_CLUSTER2>;
	cursor-win-id = <ROCKCHIP_VOP2_ESMART2>;
};

&display_subsystem {
	clocks = <&hdptxphy_hdmi0>;
	clock-names = "hdmi0_phy_pll";
};

/* ====================================================================== */
/* eMMC (on NX5 module)                                                   */
/* ====================================================================== */

&sdhci {
	status = "okay";
};

/* ====================================================================== */
/* Pin control                                                             */
/* ====================================================================== */

&pinctrl {
	omg-power {
		/* GPIO0_B4 – Power_Fail_Interrupt input from RP2040 (Pin 121) */
		power_fail_int_pin: power-fail-int-pin {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		/* GPIO0_B3 – Safe_To_Cut_Power output to RP2040 (Pin 119) */
		safe_to_cut_pin: safe-to-cut-pin {
			rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	omg-resets {
		/* GPIO3_B7 – NVMe M-Key PERST# (direct to M.2 pin 22, no inverter) */
		nvme_reset_pin: nvme-reset-pin {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/* GPIO3_C0 – WiFi E-Key PERST# (direct to M.2 pin 22, no inverter) */
		wifi_reset_pin: wifi-reset-pin {
			rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		/* GPIO3_C1 – USB2517 Hub #1 RESET# (active-low) */
		hub1_reset_pin: hub1-reset-pin {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		/* GPIO3_C2 – USB2517 Hub #2 RESET# (active-low) */
		hub2_reset_pin: hub2-reset-pin {
			rockchip,pins = <3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
